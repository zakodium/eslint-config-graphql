{
  "name": "@zakodium/eslint-config-graphql",
  "version": "9.0.0",
  "description": "ESLint config for GraphQL files",
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "license": "MIT",
  "repository": "https://github.com/zakodium/eslint-config-graphql",
  "scripts": {
    "eslint": "eslint . --ignore-pattern 'test/{operations,schema}/**'",
    "eslint-fix": "npm run eslint -- --fix",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "test": "npm run test-only && npm run eslint && npm run prettier",
    "test-only": "node test/test.js"
  },
  "dependencies": {
    "@graphql-eslint/eslint-plugin": "^5.0.0"
  },
  "peerDependencies": {
    "eslint": "^10.10.0",
    "graphql": "^16.15.0 || ^17.1.0"
  },
  "devDependencies": {
    "eslint": "10.10.0",
    "eslint-config-cheminfo": "^19.5.1",
    "graphql": "16.15.0",
    "prettier": "^3.10.1"
  }
}
